generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// 認証・操作ログ
// ─────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  loginId      String   @unique
  email        String   @unique
  displayName  String // "宮村" | "尾崎" | "岩下"
  passwordHash String
  role         String   @default("user") // "admin" | "user"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedCases Case[]     @relation("CaseOwner")
  auditLogs  AuditLog[]
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String   @default("")
  targetId   String   @default("")
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────
// 顧客
// ─────────────────────────────────────────────────────────

model Client {
  id            String   @id @default(cuid())
  clientNumber  Int      @unique
  companyName   String // 企業名又は屋号（v4でtradeNameを統合）
  clientType    String   @default("法人") // "法人" | "個人"（源泉所得税の要否判定に使用）
  address       String   @default("") // 暗号化
  contactName   String   @default("") // 暗号化
  phone         String   @default("") // 暗号化
  email         String   @default("") // 暗号化
  contactMethod String   @default("")
  source        String   @default("") // "紹介" | "HP経由"
  referrerName  String   @default("") // sourceが「紹介」の場合の紹介者名
  notes         String   @default("")
  createdAt     DateTime @default(now())

  cases    Case[]
  invoices Invoice[]
}

// ─────────────────────────────────────────────────────────
// 案件
// ─────────────────────────────────────────────────────────

model Case {
  id           String  @id @default(cuid())
  caseNumber   String
  title        String
  clientName   String // 暗号化
  clientId     String?
  client       Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  stage        String
  closedDate   String   @default("") // 終結日（v10 3.1）。この日付を基準に月ごとの終結件数を集計する
  priority     String   @default("通常") // v10でUI廃止（4.8）。データ構造上は残置
  ballOwner    String   @default("事務所")
  ballAssignee String   @default("")
  hidden       Boolean  @default(false)
  deadline     String   @default("")
  isTimeChargeCase Boolean @default(false) // タイムチャージの対象案件かどうか（v7 3.1・4.3）
  timeChargeRate Int?    // タイムチャージ時間単価（円）。請求書作成の同機能と共通（v10 3.1）
  customFields Json     @default("[]") // 案件情報カード下部の自由項目 {label,value}[]（v10 3.1）

  ownerId   String?
  owner     User?   @relation("CaseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  isPrivate Boolean @default(false)

  // 訴訟関係者情報（v4：相手方代理人は「案件情報」側の1セットに統合。ここには裁判所書記官のみ残す）
  courtCaseNumber       String @default("")
  courtClerkName        String @default("")
  courtClerkAffiliation String @default("")
  courtClerkPhone       String @default("")
  courtClerkFax         String @default("")
  courtClerkEmail       String @default("")

  // 受任関連チェック
  poaStatus      String @default("対応不要")
  contractStatus String @default("対応不要")
  retainerStatus String @default("対応不要")

  // 主張予定メモ（v13で単一テキストから積み重ね式のメモ一覧に変更。claimMemoは旧データ互換のため残置・未使用）
  claimMemo String @default("")
  claimMemos ClaimMemoEntry[]

  // 案件情報（v4：相手方代理人情報はここに一本化。旧opposingCounselName/opposingCounselContact*は廃止）
  caseClassification         String  @default("")
  opposingParty               String  @default("") // 暗号化
  opposingPartyPhone           String  @default("") // 暗号化
  opposingPartyContactMethod   String  @default("")
  opposingCounselOffice        String  @default("") // 暗号化（相手方代理人の事務所名）
  opposingCounselPersonName    String  @default("") // 暗号化（相手方代理人の氏名）
  opposingCounselPhone         String  @default("") // 暗号化
  opposingCounselFax            String  @default("") // 暗号化
  opposingCounselEmail          String  @default("") // 暗号化
  opposingCounselContactMethod  String  @default("")
  engagementDate           String  @default("")
  litigationEngagementDate String  @default("")
  noticeSentDate           String  @default("")
  filingDate               String  @default("")
  claimAmount              Int?
  retainerFee              Int?
  expectedFee              Int?
  expectedFeeDate          String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hearings    Hearing[]
  expenses    Expense[]
  updates     UpdateLog[]
  timeCharges TimeCharge[]
  invoices    Invoice[]

  @@index([stage])
  @@index([caseNumber])
  @@index([clientId])
  @@index([ownerId])
}

model Hearing {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  date            String // 記録日 YYYY-MM-DD
  content         String
  docDeadline     String   @default("")
  nextHearingDate String   @default("")
  createdAt       DateTime @default(now())

  @@index([caseId])
  @@index([date])
}

// 主張予定メモ（v13）：経過記録と同様に積み重ね式で記録し、後から個別に編集・削除できる。
model ClaimMemoEntry {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  content   String
  author    String   @default("")
  createdAt DateTime @default(now())

  @@index([caseId])
}

model Expense {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  date        String
  amount      Int
  category    String
  origin      String   @default("")
  destination String   @default("")
  route       String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now())

  billedInInvoiceId String?  // この実費が反映済みの請求書（v10 3.3）
  invoice            Invoice? @relation(fields: [billedInInvoiceId], references: [id], onDelete: SetNull)
  checkedForBilling Boolean  @default(false) // 顧客詳細「実費履歴」の請求チェック（v12 3.2）

  @@index([caseId])
  @@index([billedInInvoiceId])
}

model UpdateLog {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  author    String
  note      String
  auto      Boolean  @default(false)

  @@index([caseId])
}

// ─────────────────────────────────────────────────────────
// タイムチャージ・日報
// ─────────────────────────────────────────────────────────

model TimeCharge {
  id         String   @id @default(cuid())
  personName String
  date       String
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  startTime  String   @default("") // "HH:MM"（v7 4.2）
  endTime    String   @default("") // "HH:MM"（v7 4.2）
  hours      Float
  content    String   @default("")
  billed     Boolean  @default(false)
  invoiceId  String?
  invoice    Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([personName])
  @@index([caseId])
  @@index([invoiceId])
}

model DailyReport {
  id            String   @id @default(cuid())
  personName    String
  date          String
  caseId        String?
  mostImportant String   @default("") // 本日一番大事なこと（引き継がない）
  todayTasks    String   @default("") // 本日やること（未記入日は前回から引き継ぎ）
  waitingCases  String   @default("") // 待ち案件（未記入日は前回から引き継ぎ）
  workHours     String   @default("") // 本日の業務時間・実績（退勤時記入、v11 3.2）
  remainingTasks String  @default("") // 本日時点での残タスク（退勤時記入）
  todaySuccess  String   @default("") // 今日の成功（引き継がない）
  createdAt     DateTime @default(now())

  @@index([personName])
}

// ─────────────────────────────────────────────────────────
// パスワード管理
// ─────────────────────────────────────────────────────────

model PasswordEntry {
  id        String   @id @default(cuid())
  category  String
  service   String
  url       String   @default("")
  username  String   @default("") // 暗号化
  password  String // 暗号化
  notes     String   @default("")
  createdAt DateTime @default(now())

  @@index([category])
}

// ─────────────────────────────────────────────────────────
// 目標
// ─────────────────────────────────────────────────────────

model GoalRecord {
  id             String     @id @default(cuid())
  key            String // company | ozaki | iwashita
  yearMonth      String // YYYY-MM
  overallPercent String     @default("")
  memo           String     @default("") // カード下部の自由記述欄（v10 3.6）
  items          GoalItem[]

  @@unique([key, yearMonth])
}

model GoalItem {
  id           String     @id @default(cuid())
  goalRecordId String
  goalRecord   GoalRecord @relation(fields: [goalRecordId], references: [id], onDelete: Cascade)
  text         String
  result       String     @default("") // "" | ○ | △ | ×
  note         String     @default("")

  @@index([goalRecordId])
}

// ─────────────────────────────────────────────────────────
// ノウハウ・ひながた
// ─────────────────────────────────────────────────────────

model KnowhowEntry {
  id        String   @id @default(cuid())
  category  String
  title     String
  content   String
  createdAt DateTime @default(now())

  images KnowhowImage[]

  @@index([category])
}

// ノウハウへのスクリーンショット等の画像添付（v13）。実ファイルはVercel Blob（private）に保存する。
model KnowhowImage {
  id               String       @id @default(cuid())
  knowhowId        String
  knowhow          KnowhowEntry @relation(fields: [knowhowId], references: [id], onDelete: Cascade)
  blobUrl          String
  originalFileName String       @default("")
  fileSize         Int          @default(0)
  mimeType         String       @default("")
  createdAt        DateTime     @default(now())

  @@index([knowhowId])
}

// v10でWordファイルアップロード方式に全面変更（3.4）。実ファイルはVercel Blobに保存し、
// ここにはパス・メタデータのみ持たせる。
model Template {
  id               String   @id @default(cuid())
  name             String
  blobUrl          String   @default("")
  originalFileName String   @default("")
  fileSize         Int      @default(0)
  mimeType         String   @default("")
  updatedAt        DateTime @updatedAt
}

// 案件分類（v10で拡張可能に変更、3.7）。ノウハウの分類タブとも共有する。
model CaseClassification {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────
// 請求書
// ─────────────────────────────────────────────────────────

// v12 3.1：請求書の紐づけ先を「案件」から「顧客」に変更。clientIdが主キー、caseIdは
// v11以前のデータ互換のためのフォールバックとして残置（表示・遷移は clientId 優先）。
model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber Int      @unique
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  caseId        String? // 廃止（v11以前の過去データ互換用）
  case          Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  clientName    String // 発行時点のスナップショット（暗号化）。addresseeまたは顧客名から決定
  addressee     String   @default("") // 宛先の自由入力欄（v12 3.1）。空欄なら顧客名を使用
  caseTitle     String   @default("") // 廃止・表示しない（過去データ互換用に残置）
  issueDate     String
  billingMonth  String   @default("") // 請求対象月（YYYY-MM）。任意項目、すべての請求書に必須ではない
  honorific     String   @default("御中") // 宛名の敬称「御中」|「様」（v10 3.2）
  dueDate       String   @default("") // 支払期限（v10 3.2）
  notes         String   @default("")
  sourceExpenseIds Json  @default("[]") // 作成時点で請求チェックが入っていた実費ID一覧（v12 3.1）
  paid          Boolean  @default(false)
  paidAt        String   @default("")
  createdAt     DateTime @default(now())

  sections    InvoiceSection[]
  timeCharges TimeCharge[]
  expenses    Expense[]

  @@index([clientId])
  @@index([caseId])
}

// 請求書の区分（v9 3.8）：第1・第2…と任意個数追加できる。種別ごとに消費税・源泉徴収の
// 適用可否が変わる（「弁護士報酬」区分にのみ適用）。sortOrderが区分の表示順（＝第N）。
model InvoiceSection {
  id               String  @id @default(cuid())
  invoiceId        String
  invoice          Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type             String // "弁護士報酬" | "実費お預かり金" | "実費ご返金" | "その他"
  customTypeLabel  String  @default("") // typeが「その他」の場合のみ使用する自由入力の項目名
  applyTax         Boolean @default(false)
  applyWithholding Boolean @default(false)
  sortOrder        Int     @default(0)

  items InvoiceSectionItem[]

  @@index([invoiceId])
}

model InvoiceSectionItem {
  id          String         @id @default(cuid())
  sectionId   String
  section     InvoiceSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  description String
  amount      Int // マイナス可（実費の返金等）
  sortOrder   Int            @default(0)

  @@index([sectionId])
}
