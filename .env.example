# ローカルPostgresの接続文字列（インストール時に設定したpostgresユーザーのパスワードに置き換えてください）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legal_case_tracker?schema=public"

# 事務所共通のログインパスワード（本番では必ず推測しにくい値に変更してください）
APP_PASSWORD="change-me"

# セッションCookieの署名に使う秘密鍵（ランダムな長い文字列。例: openssl rand -hex 32）
SESSION_SECRET="change-me-to-a-long-random-string"
