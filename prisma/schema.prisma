generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// 認証・操作ログ
// ─────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  loginId      String   @unique
  email        String   @unique
  displayName  String // "宮村" | "尾崎" | "岩下"
  passwordHash String
  role         String   @default("user") // "admin" | "user"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedCases Case[]     @relation("CaseOwner")
  auditLogs  AuditLog[]
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String   @default("")
  targetId   String   @default("")
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────
// 顧客
// ─────────────────────────────────────────────────────────

model Client {
  id            String   @id @default(cuid())
  clientNumber  Int      @unique
  companyName   String // 企業名又は屋号（v4でtradeNameを統合）
  clientType    String   @default("法人") // "法人" | "個人"（源泉所得税の要否判定に使用）
  address       String   @default("") // 暗号化
  contactName   String   @default("") // 暗号化
  phone         String   @default("") // 暗号化
  email         String   @default("") // 暗号化
  contactMethod String   @default("")
  source        String   @default("") // "紹介" | "HP経由"
  referrerName  String   @default("") // sourceが「紹介」の場合の紹介者名
  notes         String   @default("")
  createdAt     DateTime @default(now())

  cases Case[]
}

// ─────────────────────────────────────────────────────────
// 案件
// ─────────────────────────────────────────────────────────

model Case {
  id           String  @id @default(cuid())
  caseNumber   String
  title        String
  clientName   String // 暗号化
  clientId     String?
  client       Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  stage        String
  priority     String   @default("通常")
  ballOwner    String   @default("事務所")
  ballAssignee String   @default("")
  hidden       Boolean  @default(false)
  deadline     String   @default("")
  isTimeChargeCase Boolean @default(false) // タイムチャージの対象案件かどうか（v7 3.1・4.3）

  ownerId   String?
  owner     User?   @relation("CaseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  isPrivate Boolean @default(false)

  // 訴訟関係者情報（v4：相手方代理人は「案件情報」側の1セットに統合。ここには裁判所書記官のみ残す）
  courtCaseNumber       String @default("")
  courtClerkName        String @default("")
  courtClerkAffiliation String @default("")
  courtClerkPhone       String @default("")
  courtClerkFax         String @default("")
  courtClerkEmail       String @default("")

  // 受任関連チェック
  poaStatus      String @default("対応不要")
  contractStatus String @default("対応不要")
  retainerStatus String @default("対応不要")

  // 主張予定メモ
  claimMemo String @default("")

  // 案件情報（v4：相手方代理人情報はここに一本化。旧opposingCounselName/opposingCounselContact*は廃止）
  caseClassification         String  @default("")
  opposingParty               String  @default("") // 暗号化
  opposingPartyPhone           String  @default("") // 暗号化
  opposingPartyContactMethod   String  @default("")
  opposingCounselOffice        String  @default("") // 暗号化（相手方代理人の事務所名）
  opposingCounselPersonName    String  @default("") // 暗号化（相手方代理人の氏名）
  opposingCounselPhone         String  @default("") // 暗号化
  opposingCounselFax            String  @default("") // 暗号化
  opposingCounselEmail          String  @default("") // 暗号化
  opposingCounselContactMethod  String  @default("")
  engagementDate           String  @default("")
  litigationEngagementDate String  @default("")
  noticeSentDate           String  @default("")
  filingDate               String  @default("")
  claimAmount              Int?
  retainerFee              Int?
  expectedFee              Int?
  expectedFeeDate          String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hearings    Hearing[]
  expenses    Expense[]
  updates     UpdateLog[]
  timeCharges TimeCharge[]
  invoices    Invoice[]

  @@index([stage])
  @@index([caseNumber])
  @@index([clientId])
  @@index([ownerId])
}

model Hearing {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  date            String // 記録日 YYYY-MM-DD
  content         String
  docDeadline     String   @default("")
  nextHearingDate String   @default("")
  createdAt       DateTime @default(now())

  @@index([caseId])
  @@index([date])
}

model Expense {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  date        String
  amount      Int
  category    String
  origin      String   @default("")
  destination String   @default("")
  route       String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now())

  @@index([caseId])
}

model UpdateLog {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  author    String
  note      String
  auto      Boolean  @default(false)

  @@index([caseId])
}

// ─────────────────────────────────────────────────────────
// タイムチャージ・日報
// ─────────────────────────────────────────────────────────

model TimeCharge {
  id         String   @id @default(cuid())
  personName String
  date       String
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  startTime  String   @default("") // "HH:MM"（v7 4.2）
  endTime    String   @default("") // "HH:MM"（v7 4.2）
  hours      Float
  content    String   @default("")
  billed     Boolean  @default(false)
  invoiceId  String?
  invoice    Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([personName])
  @@index([caseId])
  @@index([invoiceId])
}

model DailyReport {
  id            String   @id @default(cuid())
  personName    String
  date          String
  caseId        String?
  mostImportant String   @default("") // 本日一番大事なこと（引き継がない）
  todayTasks    String   @default("") // 本日やること（未記入日は前回から引き継ぎ）
  waitingCases  String   @default("") // 待ち案件（未記入日は前回から引き継ぎ）
  todaySuccess  String   @default("") // 今日の成功（引き継がない）
  createdAt     DateTime @default(now())

  @@index([personName])
}

// ─────────────────────────────────────────────────────────
// パスワード管理
// ─────────────────────────────────────────────────────────

model PasswordEntry {
  id        String   @id @default(cuid())
  category  String
  service   String
  url       String   @default("")
  username  String   @default("") // 暗号化
  password  String // 暗号化
  notes     String   @default("")
  createdAt DateTime @default(now())

  @@index([category])
}

// ─────────────────────────────────────────────────────────
// 目標
// ─────────────────────────────────────────────────────────

model GoalRecord {
  id             String     @id @default(cuid())
  key            String // company | ozaki | iwashita
  yearMonth      String // YYYY-MM
  overallPercent String     @default("")
  items          GoalItem[]

  @@unique([key, yearMonth])
}

model GoalItem {
  id           String     @id @default(cuid())
  goalRecordId String
  goalRecord   GoalRecord @relation(fields: [goalRecordId], references: [id], onDelete: Cascade)
  text         String
  result       String     @default("") // "" | ○ | △ | ×
  note         String     @default("")

  @@index([goalRecordId])
}

// ─────────────────────────────────────────────────────────
// ノウハウ・ひながた
// ─────────────────────────────────────────────────────────

model KnowhowEntry {
  id        String   @id @default(cuid())
  category  String
  title     String
  content   String
  createdAt DateTime @default(now())

  @@index([category])
}

model Template {
  id        String   @id @default(cuid())
  name      String
  content   String   @default("")
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────
// 請求書
// ─────────────────────────────────────────────────────────

model Invoice {
  id               String   @id @default(cuid())
  invoiceNumber    Int      @unique
  caseId           String
  case             Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  clientName       String // 発行時点のスナップショット、暗号化
  caseTitle        String
  issueDate        String
  applyTax         Boolean  @default(true)
  applyWithholding Boolean  @default(true)
  expenseAmount    Int      @default(0)
  notes            String   @default("")
  paid             Boolean  @default(false)
  paidAt           String   @default("")
  createdAt        DateTime @default(now())

  feeItems    FeeItem[]
  timeCharges TimeCharge[]

  @@index([caseId])
}

model FeeItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  amount      Int

  @@index([invoiceId])
}
