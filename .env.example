# PostgreSQLの接続文字列（インストール時に設定したpostgresユーザーのパスワードに置き換えてください）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legal_case_tracker?schema=public"

# セッションCookieの署名に使う秘密鍵（ランダムな長い文字列。例: openssl rand -hex 32）
SESSION_SECRET="change-me-to-a-long-random-string"

# パスワード管理・依頼者個人情報の暗号化に使う鍵（32バイト=64桁の16進数文字列。例: openssl rand -hex 32）
ENCRYPTION_KEY="change-me-to-a-64-char-hex-string"

# AI機能（AI入力・経路自動計算・クライアント報告文作成）用のAnthropic APIキー。
# 未設定でも他の機能はすべて動作し、AI機能のみ「利用できません」と表示されます。
# https://console.anthropic.com/ で発行できます。
ANTHROPIC_API_KEY=""

# 使用するClaudeモデル（省略可、既定値は claude-sonnet-5）
ANTHROPIC_MODEL="claude-sonnet-5"

# ひな形（Wordファイル）の保存に使うVercel Blob（privateストア推奨）。
# Vercel上で動かす場合はOIDC認証が自動的に使われるため、プロジェクトにBlobストアを
# 「Connect」するだけでよく、このトークンの設定は不要です。
# ローカル開発でVercel外から接続する場合のみ、`vercel login && vercel env pull` を
# 実行するか、Blob Storeの `.env.local` タブから値を取得してここに設定してください。
BLOB_READ_WRITE_TOKEN=""
